{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "generate-key": "tsx scripts/generateApiKey.ts",
    "admin:key": "tsx scripts/adminKey.ts",
    "seed:demo": "tsx scripts/seedDemoData.ts",
    "clear:demo": "tsx scripts/clearDemoData.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/compress": "^8.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/static": "^10.1.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.7.4",
    "p-retry": "^7.1.1",
    "p-timeout": "^7.0.1",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.46.4",
    "vitest": "^5.0.1"
  },
  "description": "AI Model Router routing engine \u2014 task-aware model selection, fallback chains and cost accounting over multiple LLM providers.",
