# AI Model Router API. Every setting here is optional.
# With an empty file the server starts on http://localhost:3000, creates
# data/ai-model-router.db, and simulates completions (offline mode).

# --- Providers -------------------------------------------------------------
# Prefer the Connect your providers section in Settings, or set keys here.
# Environment values take precedence over saved keys and require a restart.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
# Also raises the rate limit on the public model-pricing catalog (not required).
OPENROUTER_API_KEY=

# Optional disconnected mode (uncomment both to prevent provider/catalog calls).
# These read 1 or 0 only. Spelling either one "true" stops the server rather
# than being ignored, because an ignored offline switch spends real credit.
# AI_MODEL_ROUTER_OFFLINE=1
# AI_MODEL_ROUTER_DISABLE_CATALOG_FETCH=1

# --- Server ----------------------------------------------------------------
PORT=3000
HOST=127.0.0.1
# Origins allowed to call the API from a browser (the dashboard's dev server).
CORS_ORIGIN=http://localhost:3001

# --- Storage ---------------------------------------------------------------
# SQLite file, created on first run.
DATABASE_PATH=data/ai-model-router.db

# --- Access control --------------------------------------------------------
# Optional legacy shared API key. Prefer revocable app keys created in Settings.
AI_MODEL_ROUTER_API_KEY=
# Settings always requires an administrator key. Run npm run admin:key to see it.
# On a host, set a separate random administrator secret of at least 32 characters.
# AI_MODEL_ROUTER_ADMIN_KEY=your-host-managed-administrator-secret
# Optional 32 random bytes encoded as base64. Otherwise credentials.key is
# created beside the SQLite database. Keep it with the database during backups.
# AI_MODEL_ROUTER_ENCRYPTION_KEY=

# --- Limits ----------------------------------------------------------------
# The shared budget for /v1, per instance. 0 turns it off, for an instance
# behind something that already limits. Guessing a key still runs out of
# attempts: that budget is per address, fixed at 60 a minute, and separate.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SEC=60
